# Netatmo OAuth2 credentials
# Create an app at https://dev.netatmo.com/apps/
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# OAuth2 redirect URL (must match what you registered in the Netatmo dev portal)
NETATMO_REDIRECT_URL=http://localhost:8080/auth/callback

# Station / module MAC addresses (optional — auto-discovered if left blank)
# Found in the Netatmo app under Settings → My Home → Station
NETATMO_STATION_ID=
NETATMO_OUTDOOR_MODULE_ID=
NETATMO_WIND_MODULE_ID=
NETATMO_RAIN_MODULE_ID=

# Where to persist the OAuth2 token (default: ~/.mycast/tokens.json)
TOKEN_FILE=

# HTTP server port
PORT=8080

# How often to poll the station for new data (minutes)
FETCH_INTERVAL_MIN=30

# Days of history to keep in memory (affects forecast accuracy)
HISTORY_DAYS=7

# Use Open-Meteo (ECMWF) as the primary 3-day forecast source, with a local
# bias correction learned from the station's own readings. Falls back to the
# pure station model automatically if Open-Meteo is unreachable or the
# station's location isn't known yet. No API key required.
#
# Aurora visibility forecasting (NOAA SWPC Kp index, also no API key) is
# automatically enabled alongside this — it needs the same cloud cover and
# sunrise/sunset data the ECMWF path already fetches.
OPENMETEO_ENABLED=true
